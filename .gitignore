# Storage & Security Log Exclusions
security/audit_logs/*
!security/audit_logs/.gitkeep
backend/storage/settings/*
!backend/storage/settings/.gitkeep
*.tsbuildinfo
*.db
*.sqlite
*.sqlite3

# Scratch & Temporary Testing Files (Ignore all scratch contents except .gitkeep)
backend/scratch/*
!backend/scratch/.gitkeep
scratch/*
!scratch/.gitkeep

# Data Architecture Exclusions
data/*
!data/interim/
data/interim/*
!data/interim/document_processing/
data/interim/document_processing/*
!data/interim/document_processing/ground_truth_annotations/
data/interim/document_processing/ground_truth_annotations/backups/
!data/**/.gitkeep

# Model Weight Artifacts Exclusions
models/**
!models/
!models/**/
!models/**/.gitkeep

storage/uploads/*
!storage/uploads/.gitkeep
storage/models/*
!storage/models/.gitkeep

# Node & Next.js
node_modules/
.next/
out/
.pnp
.pnp.js

